# Copy to .env for local runs. Do not commit .env.

# Port the gateway listens on.
PORT=3000
# Comma-separated HTTPS hostnames for streams you are authorized to play.
# Example: media.example.com,cdn.example.net
STREAM_ALLOWED_HOSTS=commondatastorage.googleapis.com,test-streams.mux.dev
# Comma-separated browser origins allowed to call the API; * allows any origin.
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_MS=3600000
MAX_SESSION_SOURCES=12

# Enables the legal embed-test provider. Read only after that provider is registered
# in src/resolver.js; until then this flag has no effect.
EMBED_TEST_ENABLE=false
# Enables the AnimePahe provider. Read only after that provider is registered
# in src/resolver.js; until then this flag has no effect. Keep false on Render.
ANIMEPAHE_ENABLE=false
