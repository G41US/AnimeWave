<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ink">#FF07080D</color>
    <!-- Matches the black behind the logo artwork. -->
    <color name="logo_black">#FF030208</color>
    <style name="Theme.AnimeWave" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:colorBackground">@color/ink</item>
    </style>
    <!-- System splash shown the instant the app is tapped, then the animated title screen. -->
    <style name="Theme.AnimeWave.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/logo_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.AnimeWave</item>
    </style>
</resources>
