<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: plain dark start, so AnimeWave's own launch animation plays straight away. -->
    <style name="Theme.AnimeWave" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:windowSplashScreenBackground">@color/ink</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
</resources>
